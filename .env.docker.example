# Copy this file as .env.docker and replace the sample API key before starting.
# This initial configuration enables a local seeded ESP32 for demonstrations.
APP_ENV=development
DEBUG=false
DATABASE_PATH=/var/lib/icetrack-edge/icetrack-edge.sqlite3
SEED_EDGE_DEVICE=true
EDGE_DEVICE_UID=ESP32-ICE-001
EDGE_DEVICE_API_KEY=replace-with-a-long-random-api-key
CLOUD_API_BASE_URL=
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=30
SYNC_TIMEOUT_SECONDS=10
HOST=0.0.0.0
PORT=5000
